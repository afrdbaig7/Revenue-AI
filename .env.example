# ============================================================================
# RecoverAI — Environment configuration template
# Copy to `.env` and fill in. NEVER commit real credentials.
# ============================================================================

# --- Runtime mode ------------------------------------------------------------
DEMO_MODE=true
APP_ENV=local
LOG_LEVEL=INFO

# --- PostgreSQL --------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/recoverai
DATABASE_USERNAME=recoverai
DATABASE_PASSWORD=recoverai_dev

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka / Redpanda ---------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# "inline" = process events inside the API process (demo/dev without Kafka).
# "kafka"  = publish outbox to Kafka and consume with workers (production).
EVENT_DISPATCH_MODE=inline

# --- Temporal ----------------------------------------------------------------
TEMPORAL_ENABLED=false
TEMPORAL_TARGET=localhost:7233
TEMPORAL_NAMESPACE=recoverai

# --- Razorpay (TEST MODE only) ------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Base URL; keep the test-mode endpoint.
RAZORPAY_API_BASE=https://api.razorpay.com
# Overrides for local fixture-based simulation (no network calls):
RAZORPAY_MOCK_MODE=true

# --- LLM provider (optional; app works without it) ----------------------------
LLM_PROVIDER=          # openai | gemini | groq | none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=2

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_BASE=/api/v1

# --- Observability ------------------------------------------------------------
OTEL_SERVICE_NAME=recoverai-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Security (development defaults only) -------------------------------------
JWT_ISSUER=recoverai-local
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# 32+ char random string in real environments
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_MINIMUM_SECRET_KEY_0000
